# Supabase — Settings > Data API 의 Project URL, Settings > API Keys 의 anon 키.
# service_role 키는 쓰지 않는다. 여기에 넣지 말 것.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# OG 메타태그의 절대 URL을 만드는 데 쓰인다. 배포 도메인으로 바꿀 것.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 책장의 책 검색. Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키.
# (JavaScript 키가 아니다.) 서버에서만 읽으므로 NEXT_PUBLIC_ 을 붙이지 않는다.
KAKAO_REST_API_KEY=
